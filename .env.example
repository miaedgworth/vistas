# Copy to .env.local for local development, and set the same three in
# Vercel → Settings → Environment Variables for the live site.

# Postgres connection string. Neon's pooled URL in production; any Postgres
# works locally. Without it the site still renders, using its built-in
# content, but the admin area won't work.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs the admin session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# The admin password, hashed. Generate with:
#   node scripts/set-password.mjs 'your new password'
ADMIN_PASSWORD_HASH=""
